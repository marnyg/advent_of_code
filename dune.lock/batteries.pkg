(version 3.8.0)

(build
 (progn
  (when
   %{pkg-self:dev}
   (run dune subst))
  (run dune build -p %{pkg-self:name} -j %{jobs} @install)))

(depends dune ocaml camlp-streams ocamlfind num)

(source
 (fetch
  (url
   https://github.com/ocaml-batteries-team/batteries-included/archive/refs/tags/v3.8.0.tar.gz)
  (checksum md5=b691e5870f876c6e590d6aa51b4c5457)))
